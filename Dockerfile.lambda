# Container image for AWS Lambda using the Lambda Web Adapter.
# The adapter proxies Lambda Function URL or API Gateway requests to the
# Node process on port 3000. JSON response mode avoids a long-lived SSE stream.
# This image was not deployed from the hackathon build environment.
FROM public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 AS adapter
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=adapter /lambda-adapter /opt/extensions/lambda-adapter
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ENV AWS_LWA_PORT=3000
ENV AWS_LWA_READINESS_CHECK_PATH=/health
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY public ./public
EXPOSE 3000
CMD ["node", "dist/index.js"]
